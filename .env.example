# ---- apps/api ----
ENV=dev                      # dev | prod
DATABASE_URL=                # postgresql+asyncpg://... in prod; sqlite default in dev
REDIS_URL=                   # required in prod (shared rate limits)
ANTHROPIC_API_KEY=           # platform upstream (per-org vault comes later)
OPENAI_API_KEY=
ALLOW_MOCK_UPSTREAM=true     # dev only; ignored in prod
# NEXORA account SSO (JWT verification)
AUTH_JWKS_URL=https://clerk.onenexora.com/.well-known/jwks.json   # NEXORA account (Clerk) JWKS
AUTH_ISSUER=https://clerk.onenexora.com
DEV_AUTH=true                # dev only; ignored in prod
CREDENTIAL_ENCRYPTION_KEY=    # 32 random bytes, base64 (python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"). Required in prod; encrypts customers' provider keys
MOCK_PROVIDER_CHECK=false    # dev/e2e only: accept provider keys without calling the provider
ACCOUNT_WEBHOOK_SECRET=       # Clerk (Svix) signing secret for POST /webhooks/account
RETENTION_JOB_ENABLED=true   # daily log purge + usage rollup
CORS_ORIGINS=http://localhost:3000,https://gateway.onenexora.com
APP_URL=http://localhost:3000
# Stripe (TEST keys until deploy)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
# Email (invites, quota alerts): not wired yet
# Email alerts at 80% and 100% of the monthly quota (to owners and admins). Both needed; the dashboard banner shows either way.
RESEND_API_KEY=
ALERT_FROM_EMAIL=            # e.g. NEXORA Gateway <alerts@your-verified-domain>

# ---- apps/web (.env.local) ----
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_DEV_AUTH=1       # dev only; leave unset/0 in production
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=   # the NEXORA account instance's PUBLIC key (not a secret); empty = dashboard refuses to load unless NEXT_PUBLIC_DEV_AUTH=1
NEXT_PUBLIC_SIGN_IN_URL=https://account.onenexora.com/sign-in
