# Copy to deploy/.env.prod ON THE SERVER and fill in. Never commit the real file.
GATEWAY_WEB_HOST=gateway-next.onenexora.com
GATEWAY_API_HOST=gateway-next-api.onenexora.com
POSTGRES_PASSWORD=
# 32 random bytes, base64 (openssl rand -base64 32). Losing it makes saved customer provider keys unreadable: keep a copy in a password manager.
CREDENTIAL_ENCRYPTION_KEY=
# NEXORA account SSO (Clerk): JWKS URL and issuer of the account service
AUTH_JWKS_URL=
AUTH_ISSUER=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_SIGN_IN_URL=
# Optional until used
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ACCOUNT_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
RESEND_API_KEY=
ALERT_FROM_EMAIL=
